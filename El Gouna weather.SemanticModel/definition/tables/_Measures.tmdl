table _Measures
	lineageTag: a7c497f7-24f7-4fba-b01d-5eee21c00dc1

	measure 'Total kWh' = SUM ( fact_energy_hourly[energy_kwh] )
		formatString: #,0
		displayFolder: Consumption
		lineageTag: 646eaa29-7967-4e06-91ab-09af222bfe3f

	measure 'HVAC kWh' = SUM ( fact_energy_hourly[hvac_kwh] )
		formatString: #,0
		displayFolder: Consumption
		lineageTag: b2d70943-ed6d-48e7-8142-f7c3eac1f67b

	measure 'Base kWh' = SUM ( fact_energy_hourly[base_kwh] )
		formatString: #,0
		displayFolder: Consumption
		lineageTag: b3235d8e-e5e2-4040-b73c-9092e90e324f

	measure 'HVAC Share %' = DIVIDE ( [HVAC kWh], [Total kWh] )
		formatString: 0.0%
		displayFolder: Consumption
		lineageTag: 99a5650c-4835-41ad-bb0a-14d65a65098b

	measure 'Total Cost' = SUM ( fact_energy_hourly[cost] )
		formatString: #,0
		displayFolder: Consumption
		lineageTag: eca656c8-c9bd-42a5-bb36-3b844071f0f1

	measure 'CO2 Tonnes' = DIVIDE ( SUM ( fact_energy_hourly[co2_kg] ), 1000 )
		formatString: #,0.0
		displayFolder: Consumption
		lineageTag: 907563da-f222-4467-8b32-cd554ee4fe6b

	measure 'Energy Intensity kWh per m2' = DIVIDE ( [Total kWh], SUM ( dim_building[floor_area_m2] ) )
		formatString: #,0.0
		displayFolder: Consumption
		lineageTag: 7188d938-b4d8-4dff-8b82-8f6865a09353

	measure 'Peak Demand kW' =
			MAXX (
			    VALUES ( fact_energy_hourly[timestamp_utc] ),
			    CALCULATE ( SUM ( fact_energy_hourly[energy_kwh] ) )
			)
		formatString: #,0
		displayFolder: Consumption
		lineageTag: 483a404b-3804-4017-9058-df334b0d3fbc

	measure 'Avg Daily kWh' = AVERAGEX ( VALUES ( dim_date[date] ), [Total kWh] )
		formatString: #,0
		displayFolder: Consumption
		lineageTag: c73837fd-65af-4d18-8c47-39a4fb11d5bd

	measure 'Total kWh LY' = CALCULATE ( [Total kWh], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,0
		displayFolder: Time comparison
		lineageTag: c60e730b-2606-4363-be4d-13c3b06bead0

	measure 'kWh YoY %' =
			VAR DaysWithHistory =
			    FILTER (
			        VALUES ( dim_date[date] ),
			        NOT ISBLANK ( [Total kWh] ) && NOT ISBLANK ( [Total kWh LY] )
			    )
			VAR ThisYear = CALCULATE ( [Total kWh], DaysWithHistory )
			VAR LastYear = CALCULATE ( [Total kWh LY], DaysWithHistory )
			RETURN
			    DIVIDE ( ThisYear - LastYear, LastYear )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time comparison
		lineageTag: 2e441b54-5dfd-4241-8db0-e62cd960bef2

	measure 'Avg Temperature C' =
			CALCULATE (
			    AVERAGE ( fact_weather_hourly[temperature_2m] ),
			    fact_weather_hourly[is_forecast] = 0
			)
		formatString: 0.0
		displayFolder: Weather
		lineageTag: b670337a-9090-4433-8bf4-3bb61b6c1038

	measure 'Max Temperature C' =
			CALCULATE (
			    MAX ( fact_weather_hourly[temperature_2m] ),
			    fact_weather_hourly[is_forecast] = 0
			)
		formatString: 0.0
		displayFolder: Weather
		lineageTag: e532c1ae-8b4e-48b4-ab8b-2e1da4037cfe

	measure 'Hot Hours' =
			CALCULATE (
			    COUNTROWS ( fact_weather_hourly ),
			    fact_weather_hourly[is_forecast] = 0,
			    fact_weather_hourly[temperature_2m] > 30
			)
		formatString: #,0
		displayFolder: Weather
		lineageTag: 331c9a2c-7928-482e-822f-3486963fd9ab

	measure 'Model Actual kWh' = SUM ( fact_energy_daily_model[actual_kwh] )
		formatString: #,0
		displayFolder: Model & forecast
		lineageTag: bfa5ea9e-8c35-4316-86bb-9b4f3dd9e4f4

	measure 'Model Predicted kWh' = SUM ( fact_energy_daily_model[predicted_kwh] )
		formatString: #,0
		displayFolder: Model & forecast
		lineageTag: 760654f3-6f68-47ac-9b41-f154b427e259

	measure 'Model Actual kWh 90d' = CALCULATE ( [Model Actual kWh], KEEPFILTERS ( dim_date[date] >= TODAY () - 90 ) )
		formatString: #,0
		displayFolder: Model & forecast
		lineageTag: 1d47c331-9ec4-4672-9bd2-a8fd1551bdbe

	measure 'Model Predicted kWh 90d' = CALCULATE ( [Model Predicted kWh], KEEPFILTERS ( dim_date[date] >= TODAY () - 90 ) )
		formatString: #,0
		displayFolder: Model & forecast
		lineageTag: 3bafa34c-12a6-47d3-b44f-cdebeda4ae18

	measure 'Model Variance %' = DIVIDE ( [Model Actual kWh] - [Model Predicted kWh], [Model Predicted kWh] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Model & forecast
		lineageTag: d494c1f1-882b-4929-98af-e8c9fe6140cc

	measure 'Forecast kWh Next 7 Days' = SUM ( fact_energy_forecast[predicted_kwh] )
		formatString: #,0
		displayFolder: Model & forecast
		lineageTag: 61ed048e-a65e-4d7b-9117-1f2f2e3cbf53

	measure 'Forecast Cost Next 7 Days' = [Forecast kWh Next 7 Days] * 2.30
		formatString: #,0
		displayFolder: Model & forecast
		lineageTag: de65d427-0814-4bff-9601-f9ddec57676a

	measure 'Latest Model MAPE %' =
			VAR LatestRun = MAX ( model_metrics[trained_at_utc] )
			RETURN
			    DIVIDE (
			        CALCULATE ( AVERAGE ( model_metrics[mape_pct] ), model_metrics[trained_at_utc] = LatestRun ),
			        100
			    )
		formatString: 0.0%
		displayFolder: Model & forecast
		lineageTag: 46f8256c-86b4-47da-9c1d-ad23baa1dbab

	measure 'Latest Model R2' =
			VAR LatestRun = MAX ( model_metrics[trained_at_utc] )
			RETURN
			    CALCULATE ( AVERAGE ( model_metrics[r2] ), model_metrics[trained_at_utc] = LatestRun )
		formatString: 0.000
		displayFolder: Model & forecast
		lineageTag: bbcfb39c-1f70-4a50-8fd7-56c81b53ec4f

	measure 'Cooling Sensitivity kWh per C' =
			VAR LatestRun = MAX ( model_metrics[trained_at_utc] )
			RETURN
			    CALCULATE ( SUM ( model_metrics[kwh_per_cooling_degree] ), model_metrics[trained_at_utc] = LatestRun )
		formatString: #,0.0
		displayFolder: Model & forecast
		lineageTag: deedeafe-aeb7-44e7-bea6-82d8c4dd5642

	measure 'Anomaly Hours' = COUNTROWS ( fact_anomalies ) + 0
		formatString: #,0
		displayFolder: Anomalies
		lineageTag: f99df9d7-ff87-46e3-8ab5-7d8f4fa488a4

	measure 'Anomaly Excess kWh' = SUM ( fact_anomalies[excess_kwh] )
		formatString: #,0
		displayFolder: Anomalies
		lineageTag: 74829f6f-02cd-4d0f-9f2b-a4db8cf07210

	measure 'Anomaly Excess Cost' = [Anomaly Excess kWh] * 2.30
		formatString: #,0
		displayFolder: Anomalies
		lineageTag: 9f7a9873-b4a4-4f40-8a3a-bccb796b8286

	measure 'Last Successful Refresh' = CALCULATE ( MAX ( pipeline_runs[finished_at_utc] ), pipeline_runs[status] = "success" )
		formatString: dd mmm yyyy hh:nn
		displayFolder: Pipeline health
		lineageTag: 4315a02d-c39f-4b50-aff4-7773706ae91d

	measure 'Data Freshness Label' = "Data as of " & FORMAT ( [Last Successful Refresh], "dd mmm yyyy hh:nn" ) & " UTC"
		displayFolder: Pipeline health
		lineageTag: 44e6b433-10b5-46c2-85e3-61d418843efa

	measure 'Latest Run Status' =
			VAR LatestStart = MAX ( pipeline_runs[started_at_utc] )
			RETURN
			    CALCULATE ( SELECTEDVALUE ( pipeline_runs[status] ), pipeline_runs[started_at_utc] = LatestStart )
		displayFolder: Pipeline health
		lineageTag: 0a9334c9-5a81-4650-89ec-0609088b087a

	measure 'Successful Runs %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( pipeline_runs ), pipeline_runs[status] = "success" ),
			    COUNTROWS ( pipeline_runs )
			)
		formatString: 0.0%
		displayFolder: Pipeline health
		lineageTag: 93867618-cd03-4c75-af7a-d803aa8af919

	measure 'Checks Warned Latest Run' =
			VAR LatestStart = MAX ( data_quality_checks[run_started_at_utc] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( data_quality_checks ),
			        data_quality_checks[run_started_at_utc] = LatestStart,
			        data_quality_checks[status] <> "pass"
			    ) + 0
		formatString: #,0
		displayFolder: Pipeline health
		lineageTag: 413f5771-8297-4466-bf8b-c574e6866219

	measure 'Pipeline Runs' = COUNTROWS ( pipeline_runs )
		formatString: #,0
		displayFolder: Pipeline health
		lineageTag: 8ab05c3a-d69e-4dc4-b1b6-466008464499

	column Hide
		dataType: string
		isHidden
		lineageTag: 88db1380-aadd-4ee9-aa4c-f894ce1fd987
		summarizeBy: none
		sourceColumn: Hide

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Hide = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
